<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/users/<%=user.id%>" method="post">

       <input type="text" placeholder="Enter Your Name" name="name" value="<%=user.name%>">
       <input type="text" placeholder="Enter Your Email" name="email" value="<%=user.email%>">
       <input type="text" placeholder="Enter Your Age" name="age" value="<%=user.age%>">
       <input type="text" placeholder="Enter Your Address" name="address" value="<%=user.address%>">
       <input type="text" placeholder="Enter Your bio" name="bio" value="<%=user.bio%>">
       <input type="text" placeholder="Enter Your hobbies" name="hobbies" value="<%=user.hobbies%>">
       <input type="submit" value="Update User">
    </form>
    
</body>
</html>