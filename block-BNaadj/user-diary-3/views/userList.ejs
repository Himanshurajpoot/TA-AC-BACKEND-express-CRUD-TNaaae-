<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>List of All Users</h1>
    <section>
  <%users.forEach(user=>{%>
        <div>
            <a href="/users/<%=user.id%>"><%=user.name%></a>
        </div>
    <%})%>
    </section>
  
</body>
</html>