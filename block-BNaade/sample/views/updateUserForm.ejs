<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/users/<%=user.id%>" method="post">
        <input type="text" placeholder="Enter Your Name" name="name" value="<%=user.name%>">
        <input type="text" placeholder="Enter Your Age" name="age" value="<%=user.age%>">
        <input type="text" placeholder="Enter Your Collage" name="collage" value="<%=user.collage%>">
        <input type="submit" value="Update user">
    </form>
</body>
</html>