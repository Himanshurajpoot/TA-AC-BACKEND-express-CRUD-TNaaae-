<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>welcome to users list</h1>
    <% users.forEach(user=>{%>
        <section>
            <div>
                <h2><%= user.name%></h2>
                <h3><%= user.email%></h3>
                <h4><%= user.age%></h4>
                <h5><%= user.bio%></h5>
            </div>
        </section>
   <% })%>
</body>
</html>